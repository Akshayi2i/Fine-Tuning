__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets - never commit
.env

# The repo NEVER stores weights, corpora, or documents. Everything data- or
# artifact-related is pulled from and pushed to Azure Blob at runtime via
# artifact_registry/, which is what keeps pod startup fast and decouples
# corpus/model versioning from code versioning (arch 19).
*.pdf
!tests/fixtures/**/*.pdf
*.safetensors
*.gguf
*.bin
*.ckpt

testing/results/
testing/metrics/
testing/ocr_cache/
testing/test_data/
calibration/calibration_store/
pilot/reports/

# Data audit output quotes label values (personal data). Never commit it.
data/audit_report/
# Delivered documents, their labels and redaction records hold client data:
# they travel through Azure Blob (intake/), never through git.
data/source data/
data/training data/
data/bundles/
data/CGL source data/
data/cgl_bundles/
data/bundle_exclusions.csv
data/bundle_lob_overrides.csv
# And everything else under data/: a new delivery's folder (bundles_c1, its
# exclusions) was not listed above and showed as untracked, one `git add -A`
# from a commit. Nothing under data/ is tracked.
data/

# Quotes gold-label values (VINs, postal codes, names): personal data, kept local.
configs/field_types.proposed.yaml

# Office lock files, written while a document is open in Word or Excel.
~$*
