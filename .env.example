# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Secrets come from the environment only - never from YAML in configs/.
# On the pod every long command runs through scripts/pod_run.sh, which sources this
# file - under the caller's own values: one set in the shell that starts the command,
# inline included (`FIDEON_REMOTE_TOKEN=x python -m ...`), is kept over the line here,
# even an empty one. A value the pod gives every process is not the caller's (this
# file still sets HF_HUB_ENABLE_HF_TRANSFER). Off the pod nothing reads this file:
# set the variables in the shell.

# ---------------------------------------------------------------------------
# Azure Blob - all artifacts: raw PDFs, corpora, adapters, models, registries
# ---------------------------------------------------------------------------
# Keep the double quotes: on the pod this file is sourced by bash, and without
# them the first ';' ends the value (scripts/pod_run.sh, scripts/pod_bootstrap.sh).
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=..."
# Or log in with a SAS token instead (preferred): the connection string carries
# the account key, which reaches everything and never expires; a SAS is
# short-lived and limited to the permissions it was issued with. Set both and
# the connection string above is not used. Keep the double quotes on the token:
# bash would otherwise read each '&' in it as "run in the background".
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_SAS_TOKEN=
AZURE_BLOB_CONTAINER=insurance-extraction

# raw-documents/ is the ONLY layer holding unredacted PII, so it gets its own
# container with tighter RBAC - fewer identities with read access than the
# corpus and adapter layers that training jobs need (arch 18a). intake/ and
# exports/ (delivered batches, downloadable results) live in it too.
AZURE_RAW_CONTAINER=insurance-extraction-raw
# The raw container's own SAS token (quoted, like the one above). A container
# SAS is valid for one container only, so with a SAS login:
#  - set this, and AZURE_STORAGE_SAS_TOKEN can be a container SAS for the main
#    container alone; only a pod given this token can read the raw PDFs;
#  - leave it empty, and AZURE_STORAGE_SAS_TOKEN is used for BOTH containers, so
#    it must be an ACCOUNT SAS - which reaches every container in the account,
#    raw PDFs included, from every pod that holds it. A container SAS for the
#    main container is refused (403) on every raw-document, intake/ and exports/ call.
# It needs AZURE_STORAGE_ACCOUNT_URL and AZURE_STORAGE_SAS_TOKEN set as well:
# beside a connection string alone it is refused as half a SAS login.
AZURE_RAW_SAS_TOKEN=

# ---------------------------------------------------------------------------
# RunPod - ephemeral training pods + a persistent serverless endpoint
# ---------------------------------------------------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Network volume holding adapters and the merged model BETWEEN command 1
# (finetune) and command 2 (package). Working storage with no durability
# guarantee - not the registry (master 12a). The merged model is ~16GB and
# quantization also runs on RunPod, so staging avoids a 32GB round trip.
RUNPOD_VOLUME_ID=
RUNPOD_VOLUME_MOUNT=/runpod-volume

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------
HF_TOKEN=
# Pin the revision. Also set configs/base_model.yaml model.revision to match -
# a floating revision makes a regression impossible to attribute.
HF_MODEL_REVISION=

# ---------------------------------------------------------------------------
# Experiment tracking (optional - the Blob run manifest is the durable record;
# these only add a queryable UI over it)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=
WANDB_API_KEY=

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------
# Single-tenant build: the tenant_id path prefix is reserved so no migration is
# needed later, but it is not a required CLI argument. The live rule is that a
# corpus file must never mix tenants, because corpus composition is training
# data (arch 8b).
DEFAULT_TENANT_ID=default

# ---------------------------------------------------------------------------
# Labeling
# ---------------------------------------------------------------------------
# Frontier models are never used for gold, synthetic or training data
# (decision 2026-10-19): drafts come from the self-hosted Qwen3-VL only, so
# there is no external pre-annotation endpoint or permission to configure.

# ---------------------------------------------------------------------------
# Base model and training host
# ---------------------------------------------------------------------------
# Where the pod keeps the base weights. Overrides model.local_dir in
# configs/base_model.yaml (default /workspace/models). Training, the tokenizer,
# the merge and vLLM all load the base from here, never from the Hub.
FIDEON_BASE_MODEL_DIR=
# Set to 1 to launch training on a GPU host that is not the RunPod pod. A real
# launch is otherwise refused without CUDA, the staging volume and the base.
FIDEON_ALLOW_OFF_POD=

# ---------------------------------------------------------------------------
# Jobs on the pod
# ---------------------------------------------------------------------------
# On a RunPod pod every long job (pipeline, training, OCR, eval, the spike,
# setup_pod.sh) re-launches itself inside tmux, so a closed laptop or dropped
# Wi-Fi cannot stop it (orchestration/detach.py, scripts/pod_run.sh).
# Job logs and exit codes are kept in /workspace/logs on the volume.
# Set to 1 to run one command in the foreground on the pod anyway. Leave unset.
FIDEON_NO_DETACH=
# Where data_pipeline.ingestion.pull_intake puts a batch pulled from intake/ in
# the raw container. Default /workspace/intake, on the volume. Leave unset.
FIDEON_INTAKE_DIR=
# The pod's volume, where the environments, intake, logs and the smoke run live.
# Default /workspace. Leave unset.
FIDEON_WORKSPACE=
# MinerU's own: its config file, a name under the home directory (default
# mineru.json) or an absolute path. On the pod /workspace/mineru.json, so it
# survives a stop (scripts/pod_bootstrap.sh sets it). It names the pinned
# pipeline weights: bash scripts/download_mineru_models.sh writes it.
MINERU_TOOLS_CONFIG_JSON=
# MinerU's own: the device it runs on. cuda (OCR is GPU-only); left unset, the OCR
# stage sets it before MinerU loads. Anything else is refused.
MINERU_DEVICE_MODE=
# MinerU's own: where it takes its weights from. local - the pinned ones the config
# names; left unset, the OCR stage sets it. huggingface/modelscope would fetch the
# latest, and are refused.
MINERU_MODEL_SOURCE=
# Hugging Face's own: its cache (the MinerU weights, any Hub download). On the pod
# /workspace/.cache/huggingface, because the container disk is wiped on stop.
HF_HOME=
# Hugging Face's own. RunPod images set it to 1 for every process, but hf_transfer is
# not installed in our environments, and downloads then fail. 0 on the pod.
HF_HUB_ENABLE_HF_TRANSFER=
# The extraction test server's token (testing/extract_server.py), sent by the laptop
# client as `Authorization: Bearer <token>`. Left empty, the server makes one at start
# and writes it to <work dir>/token.txt on the pod.
EXTRACT_SERVER_TOKEN=
# Bearer token for a served model and MinerU (their own servers' token, not ours):
# what testing/latency_check.py times the extraction routine against, and what
# testing/extract_server.py --model-url/--mineru-url reads through (read at start).
FIDEON_REMOTE_TOKEN=
# The served MinerU 4 API that OCRs the training corpus AND every served document
# (one MinerU for both: configs/shared/ocr.yaml pins its version and tier). Set, the
# pipeline's preprocessing stage and `run_mineru` read through it - from anywhere, no
# MinerU or GPU needed here. HTTPS only. Its token falls back to FIDEON_REMOTE_TOKEN.
MINERU_URL=
MINERU_TOKEN=
# A READ-ONLY SAS token (sp=r) for the main container, for `latency_check --images link`:
# each page is uploaded once and the served model fetches it by a link carrying this
# token, so it must not grant writing (refused if it does). Not needed when
# AZURE_STORAGE_CONNECTION_STRING holds the account key (each link is then signed alone).
PAGE_LINK_SAS_TOKEN=

# ---------------------------------------------------------------------------
# The production service on Azure (azure_service/)
# ---------------------------------------------------------------------------
# Set on its Container Apps (env vars, secrets from Key Vault), never in this
# file on the pod: every setting, its default and meaning is in
# azure_service/DEPLOY.md ("Settings"). Named here because they are read outside
# the service's settings table: the queue's SAS when STORAGE_AUTH=environment
# without a connection string, and the API's port.
AZURE_QUEUE_SAS_TOKEN=
API_PORT=
