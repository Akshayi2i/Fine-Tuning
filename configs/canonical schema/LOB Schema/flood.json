{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - flood (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for flood (L1 code flood), composing common_model.json 1.1.0 by $ref: the envelope plus the locations, buildings and countersignature blocks. Built from the single-LOB documents of the source-data flood folder (3 carrier folders, read in place): Sterling Surplus Underwriters' private flood declarations on Lloyd's paper (one-page declarations of three yearly layouts and electronic policy sets that open with the broker's cover letter), Foremost Insurance Company's National Flood Insurance Program declarations (two layouts) and IAT Insurance Group's declarations (a scan). Every field of the pre-SPEC_21 flood.json (flood.crosswalk.yaml). No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "flood",
  "fideon:lob_code": "TBD",
  "fideon:layout_family": "property_pkg",
  "fideon:schema_version": "2.0.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema (14 October 2026), built from the flood folder's single-LOB declarations; replaces the pre-SPEC_21 flood.json. Draft for the project owner's approval; the seed golds drafted against it are DRAFT, pending reviewer sign-off.",
  "fideon:built_from": {
    "seed_golds": 32,
    "carriers": [
      "Sterling Flood",
      "Foremost Insurance Company"
    ],
    "legacy_schema": "flood.json (pre-SPEC_21, _common-shaped, flood block)",
    "registry_yamls": [
      "flood"
    ],
    "corpora": [
      "synth_core/fideon/synth_core/data/source data/<Carrier>/flood/ (34 documents: 32 seeds; Sterling's renewal quote and IAT's scan are not seeds)"
    ]
  },
  "fideon:blocks_used": [
    "locations",
    "buildings",
    "countersignature"
  ],
  "fideon:lob_block": "None. Each flood coverage (building or dwelling, contents, other structures, loss of use, basement coverages, increased cost of compliance) is a coverage with its limit, deductible and premium; the insured property is a locations[] element and its building facts (occupancy, construction, floors, year built, basement) a buildings[] element. The flood rating facts the common model has no field for (flood zone, base flood and lowest floor elevations, first floor height, NFIP policy number, replacement cost value, prior claims) are additional_fields labels (SPEC_21 4.2.4; CHANGE_REQUESTS_flood.md CR-FL-03).",
  "fideon:coverage_codes_file": "flood.coverage_codes.yaml",
  "fideon:coverage_codes": [
    "FL_BASEMENT",
    "FL_BASEMENT_PERSONAL_PROPERTY",
    "FL_BUILDING",
    "FL_CONTENTS",
    "FL_ICC",
    "FL_OTHER_STRUCTURES",
    "X_LOSS_OF_USE"
  ],
  "fideon:mandatory_fields": [
    "carrier.name",
    "named_insured.primary_name",
    "policy.policy_number",
    "policy.effective_date",
    "policy.expiration_date",
    "coverages[].limits[].amount"
  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "months_between(policy.effective_date, policy.expiration_date) == policy.term_months",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1"
  ],
  "fideon:audit_rules_note": "Rules 1-4 are common_model.json fideon:default_audit_rules (the claims-made rule left out: flood is written on an occurrence basis). A rule whose values a document does not print is not evaluated.",
