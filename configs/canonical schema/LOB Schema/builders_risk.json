  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "months_between(policy.effective_date, policy.expiration_date) == policy.term_months",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1"
  ],
  "fideon:audit_rules_note": "Rules 1-4 are common_model.json fideon:default_audit_rules (the claims-made rule left out: builders risk is written on an occurrence basis). A rule whose values a document does not print is not evaluated: the US Assure renewal application prints no coverage, so rule 4 is not evaluated on it.",
