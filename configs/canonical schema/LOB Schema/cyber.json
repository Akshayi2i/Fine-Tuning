{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - cyber (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for cyber, cyber and privacy liability (L1 code cyber), composing common_model.json 1.1.0 by $ref: the envelope plus the claims_made_terms and insuring_agreements blocks. Built from the single-LOB cyber declarations of the source-data cyber folder (read in place): At-Bay's cyber insurance policy declarations (filed under AtBay and ARC Excess & Surplus), Coalition's cyber policy declarations and Corvus' smart cyber declarations on Travelers paper. Every field of the pre-SPEC_21 cyber.json (cyber.crosswalk.yaml). No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "cyber",
  "fideon:lob_code": "TBD",
  "fideon:layout_family": "exec_specialty",
  "fideon:schema_version": "2.0.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema (11 October 2026), built from the cyber folder's single-LOB declarations; replaces the pre-SPEC_21 cyber.json. Draft for the project owner's approval; the seed golds drafted against it are DRAFT, pending reviewer sign-off.",
  "fideon:built_from": {
    "seed_golds": 9,
    "carriers": [
      "AtBay",
      "ARC Excess & Surplus, LLC",
      "Coalition",
      "Travelers"
    ],
    "legacy_schema": "cyber.json (pre-SPEC_21, _common-shaped, cyber block)",
    "registry_yamls": [
      "cyber"
    ],
    "corpora": [
      "synth_core/fideon/synth_core/data/source data/<Carrier>/cyber/ (11 documents; 9 seeds)"
    ]
  },
  "fideon:blocks_used": [
    "claims_made_terms",
    "insuring_agreements"
  ],
  "fideon:lob_block": "None. Each insuring agreement the declarations schedule is a coverage (its sub-limit, its retention, whether it is included); the policy aggregate limit is the CY_POLICY_AGGREGATE coverage; waiting periods and periods of indemnity are deductibles[deductible_type=waiting_period] or additional_fields (SPEC_21 4.2.4).",
  "fideon:coverage_codes_file": "cyber.coverage_codes.yaml",
  "fideon:coverage_codes": [
