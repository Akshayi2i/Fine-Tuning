    "AU_HIRED_AUTO_LIABILITY",
    "AU_NON_OWNERSHIP_LIABILITY",
    "AU_HIRED_AUTO_PHYSICAL_DAMAGE",
    "AU_FULL_GLASS",
    "AU_COVERAGE_EXTENSION",
    "AU_OTHER_AUTO_COVERAGES",
    "X_ADDITIONAL_INSURED",
    "X_WAIVER_OF_SUBROGATION"
