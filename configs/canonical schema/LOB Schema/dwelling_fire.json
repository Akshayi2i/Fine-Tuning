{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - dwelling_fire (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for dwelling_fire (code DF), composing common_model.json 1.0.0 by $ref: the envelope plus locations and buildings. Built from all 16 dwelling fire seed golds of 4 carriers and the line's registry YAMLs. No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "dwelling_fire",
  "fideon:lob_code": "DF",
  "fideon:layout_family": "personal_lines",
  "fideon:schema_version": "1.1.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema, built from 16 seed golds of 4 carriers; field list awaiting project-owner approval",
  "fideon:built_from": {
    "seed_golds": 16,
    "carriers": [
      "Dryden Mutual",
      "Leatherstocking Cooperative Insurance Company",
      "NYCM Insurance",
      "North Country Insurance Company"
    ],
    "registry_yamls": [
      "dwelling_fire"
    ]
  },
  "fideon:blocks_used": [
    "locations",
    "buildings"
  ],
  "fideon:lob_block": "None. Every concept the seeds print has a home in the envelope or a common-model building block (SPEC_21 4.2.4).",
  "fideon:coverage_codes_file": "dwelling_fire.coverage_codes.yaml",
  "fideon:coverage_codes": [
    "DF_CONDOMINIUM_SHARED_OWNERSHIP",
    "DF_COV_A",
    "DF_COV_B",
    "DF_COV_C",
    "DF_COV_L",
    "DF_EC_LOSS_OF_USE",
    "DF_EC_OTHER_STRUCTURES",
    "DF_EC_PERSONAL_PROPERTY",
    "DF_EC_RESIDENCE",
    "DF_INCIDENTAL_BUSINESS",
    "DF_LANDLORDS_CONTENTS",
    "DF_TENANT_VANDALISM",
    "DF_VALUE_PLUS",
    "DF_VMM_LOSS_OF_USE",
    "DF_VMM_OTHER_STRUCTURES",
    "DF_VMM_PERSONAL_PROPERTY",
    "DF_VMM_RESIDENCE",
    "X_EQUIPMENT_BREAKDOWN",
    "X_LOSS_OF_USE",
    "X_MED_PAY",
    "X_WATER_BACKUP"
  ],
  "fideon:mandatory_fields": [
    "carrier.name",
    "named_insured.primary_name",
    "policy.policy_number",
    "policy.effective_date",
    "policy.expiration_date",
    "coverages[].limits[].amount"
  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "months_between(policy.effective_date, policy.expiration_date) == policy.term_months",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1",
    "`coverages[coverage_code=DF_COV_C].limits[limit_type=per_occurrence].amount` <= `coverages[coverage_code=DF_COV_A].limits[limit_type=per_occurrence].amount`",
    "premium.total == sum(coverages[].premium) + sum(forms_and_endorsements[].premium) + sum(premium.items[].amount) + sum(premium.surcharges[].amount) + sum(premium.taxes_fees[].amount) ± 0.01"
  ],
  "fideon:audit_rules_note": "Rules 1-4 are common_model.json fideon:default_audit_rules (the claims-made rule left out); NYCM prints the term. The premium rule holds on every seed whose printed amounts add up; a rule whose values a document does not print is not evaluated.",
