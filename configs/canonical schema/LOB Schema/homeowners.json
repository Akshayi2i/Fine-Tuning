  "fideon:doc_type": "policy_check",
  "fideon:lob": "homeowners",
  "fideon:lob_code": "HO",
  "fideon:layout_family": "personal_lines",
  "fideon:schema_version": "1.1.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema, built from 37 seed golds of 11 carriers; field list awaiting project-owner approval",
  "fideon:built_from": {
    "seed_golds": 37,
