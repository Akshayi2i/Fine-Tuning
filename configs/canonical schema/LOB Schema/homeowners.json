  "fideon:mandatory_fields": [
    "carrier.name",
    "named_insured.primary_name",
    "policy.policy_number",
    "policy.effective_date",
    "policy.expiration_date",
    "coverages[].limits[].amount"
  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1",
    "len(premium.items[]) == 0 or abs(premium.total - (sum(premium.items[].amount) + sum(premium.discounts[].amount) + sum(premium.surcharges[].amount) + sum(premium.taxes_fees[].amount))) <= 1"
  ],
  "fideon:audit_rules_note": "Rules 1-3 are common_model.json fideon:default_audit_rules without the claims-made rule and without the term rule (no homeowners seed prints a term in months). The premium rule applies only to a document that itemises its premium.",
