{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - umbrella (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for umbrella, commercial umbrella and excess liability (L1 code umbrella), composing common_model.json 1.1.0 by $ref: the envelope plus the underlying_insurance, attachment and countersignature blocks. Built from the single-LOB documents of the source-data cumbr folder (3 folders, read in place): Utica First's commercial umbrella/excess liability declarations (2) and CNA's follow-form excess insurance declarations (1); Sutton's commercial excess declarations is a scan (not a seed). Every field of the pre-SPEC_21 umbrella.json (umbrella.crosswalk.yaml). No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "umbrella",
  "fideon:lob_code": "UM",
  "fideon:layout_family": "casualty_fleet",
  "fideon:schema_version": "2.0.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema (11 October 2026), built from 3 seed documents of 2 carrier folders; replaces the pre-SPEC_21 umbrella.json 1.6.0. Draft for the project owner's approval; the seed golds drafted against it are DRAFT, pending reviewer sign-off.",
  "fideon:built_from": {
    "seed_golds": 3,
    "carriers": [
      "CNA Companies",
      "Utica First Insurace Company"
    ],
    "legacy_schema": "umbrella.json 1.6.0 (pre-SPEC_21, _common-shaped, umbrella block)",
    "registry_yamls": [
      "umbrella"
    ],
    "corpora": [
      "synth_core/fideon/synth_core/data/source data/<Carrier>/cumbr/ (4 documents; 3 seeds, 1 scan)"
    ]
  },
  "fideon:blocks_used": [
    "underlying_insurance",
    "attachment",
    "countersignature"
  ],
  "fideon:lob_block": "None. The umbrella or excess layer is a coverage with its limits; each scheduled underlying policy is an underlying_insurance[] element (carrier, policy number, period, coverage, limits); retentions and the attachment point are the attachment block (SPEC_21 4.2.4).",
  "fideon:coverage_codes_file": "umbrella.coverage_codes.yaml",
  "fideon:coverage_codes": [
    "UM_EXCESS_LIABILITY",
    "UM_UMBRELLA_LIABILITY",
    "UM_UNDERLYING_FOLLOWED",
    "UM_UNDERLYING_GENERAL_LIABILITY",
    "UM_UNDERLYING_LAYER",
    "X_TERRORISM"
  ],
  "fideon:mandatory_fields": [
    "carrier.name",
    "named_insured.primary_name",
    "policy.policy_number",
    "policy.effective_date",
    "policy.expiration_date",
    "coverages[].limits[].amount"
  ],
  "fideon:audit_rules": [
    "policy.effective_date < policy.expiration_date",
    "months_between(policy.effective_date, policy.expiration_date) == policy.term_months",
    "policy.effective_date <= document.transaction_effective_date <= policy.expiration_date",
    "len(coverages[].limits[]) >= 1"
  ],
  "fideon:audit_rules_note": "Rules 1-4 are common_model.json fideon:default_audit_rules (the claims-made rule left out: the seeds' umbrella and excess layers print no retroactive date). A rule whose values a document does not print is not evaluated.",
  "fideon:aliases": {
    "countersignature.date": [
      "Countersignature Date"
    ],
    "coverages[].limits[].amount": [
      "POLICY LIMIT",
      "Each Occurrence Limit",
      "General Aggregate Limit",
      "Limit of Liability",
      "Aggregate Limit"
    ],
    "named_insured.primary_name": [
      "Named Insured and Mailing Address",
      "NAMED ENTITY AND PRINCIPAL ADDRESS",
      "Named Insured & Address"
    ],
    "policy.effective_date": [
      "Policy Period",
      "POLICY PERIOD"
    ],
    "policy.expiration_date": [
      "Policy Period",
      "POLICY PERIOD"
    ],
    "policy.policy_number": [
      "Policy Number",
      "POLICY NUMBER"
    ],
    "premium.total": [
      "PREMIUM",
      "Policy Premium",
      "Premium"
    ],
    "producer.agency_name": [
      "Agent",
      "PRODUCER",
      "Broker Name & Mailing Address"
    ],
    "underlying_insurance[].carrier_name": [
      "Company",
      "Name of Carrier"
    ],
    "underlying_insurance[].policy_number": [
      "Policy Number",
      "Policy No"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "carrier",
    "named_insured",
    "policy",
    "lob_parts",
    "coverages"
  ],
  "properties": {
    "document": {
      "$ref": "../common/common_model.json#/$defs/document"
    },
    "carrier": {
      "$ref": "../common/common_model.json#/$defs/carrier"
    },
    "producer": {
      "$ref": "../common/common_model.json#/$defs/producer"
    },
    "named_insured": {
      "$ref": "../common/common_model.json#/$defs/named_insured"
    },
    "policy": {
      "$ref": "../common/common_model.json#/$defs/policy"
    },
    "lob_parts": {
      "$ref": "../common/common_model.json#/$defs/lob_parts"
    },
    "coverages": {
      "$ref": "../common/common_model.json#/$defs/coverages"
    },
    "deductibles": {
      "$ref": "../common/common_model.json#/$defs/deductibles"
    },
    "interested_parties": {
      "$ref": "../common/common_model.json#/$defs/interested_parties"
    },
    "premium": {
      "$ref": "../common/common_model.json#/$defs/premium"
    },
    "billing": {
      "$ref": "../common/common_model.json#/$defs/billing"
    },
    "forms_and_endorsements": {
      "$ref": "../common/common_model.json#/$defs/forms_and_endorsements"
    },
    "underlying_insurance": {
      "$ref": "../common/common_model.json#/$defs/underlying_insurance"
    },
    "attachment": {
      "$ref": "../common/common_model.json#/$defs/attachment"
    },
    "countersignature": {
      "$ref": "../common/common_model.json#/$defs/countersignature"
    },
    "additional_fields": {
      "$ref": "../common/common_model.json#/$defs/additional_fields"
    },
    "text_sections": {
      "$ref": "../common/common_model.json#/$defs/text_sections"
    },
    "fideon:provenance": {
      "$ref": "../common/common_model.json#/$defs/provenance"
    }
  }
}
