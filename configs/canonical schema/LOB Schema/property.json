{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fideon canonical schema - property (policy_check)",
  "description": "SPEC_21 section 4 canonical schema for property, commercial property (L1 code property), composing common_model.json 1.1.0 by $ref: the envelope plus the locations, buildings and rating_modifiers blocks. Built from the single-LOB documents of the source-data prop folder (3 carriers, read in place): the commercial property and businessowners declarations the folder files under property (Leatherstocking's Businessowner's Policy SF-10P and Commercial Fire and Liability forms, Merchants' businessowners declarations), which print the property coverages beside the liability ones, so the line's coverage codes name both. Every field of the pre-SPEC_21 property.json (property.crosswalk.yaml). Package documents (cgl_prop) are not read for this schema. No LOB block.",
  "fideon:doc_type": "policy_check",
  "fideon:lob": "property",
  "fideon:lob_code": "PR",
  "fideon:layout_family": "property_pkg",
  "fideon:schema_version": "2.0.0",
  "fideon:common_model_version": "1.1.0",
  "fideon:status": "SPEC_21 Phase 2 schema (10 October 2026), built from 6 native seed documents of 2 carriers; replaces the pre-SPEC_21 property.json (fideon.canonical.commercial_property 1.5.0). Draft for the project owner's approval; the seed golds drafted against it are DRAFT, pending reviewer sign-off.",
  "fideon:built_from": {
    "seed_golds": 6,
    "carriers": [
      "Leatherstocking Cooperative Insurance Company",
      "Merchants Mutual Insurance Group"
    ],
    "legacy_schema": "property.json (pre-SPEC_21, fideon.canonical.commercial_property 1.5.0)",
    "registry_yamls": [
      "property"
    ],
    "corpora": [
      "synth_core/fideon/synth_core/data/source data/<Carrier>/prop/ (11 documents; 6 seeds; 4 are the Landlords Package / Student Housing product the homeowners entry reads; 1 is a package)"
    ]
  },
  "fideon:blocks_used": [
    "locations",
    "buildings",
    "rating_modifiers"
  ],
  "fideon:lob_block": "None. Every concept the seeds print has a home in the envelope or a common-model building block (SPEC_21 4.2.4). Liability rows a businessowners or fire-and-liability declarations prints beside its property are coverages of this line under PR_ codes until shared codes exist (CR-PROP-02).",
